<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMCL.ViewModels"
        xmlns:models="using:SMCL.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
        x:Class="SMCL.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SMCL Minecraft Launcher">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <!-- 【底层】：主页原本布局 -->
        <Grid>
            <!-- 背景图片 -->
            <Image Source="avares://SMCL/Assets/background.png" 
                   Stretch="UniformToFill" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>

            <Grid ColumnDefinitions="250, *">
                <!-- 左侧主侧边栏 -->
                <Border Grid.Column="0" Background="#409191D5" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True">
                                                <!-- 顶部 Logo -->
                        <StackPanel DockPanel.Dock="Top" Margin="15,20,15,20" Spacing="8" HorizontalAlignment="Center">
                            <!-- 放大 Logo：将 Height 改为 60（如果图片是横向的，可以适当调整到 50-70 之间） -->
                            <!-- 如果需要等比例缩放，也可以改用 Width="180" -->
                            <Image Source="avares://SMCL/Assets/SMCL_Logo.png" Height="80" HorizontalAlignment="Center"/>
                            
                            <!-- 小字放在下方居中 -->
                            <TextBlock Text="Schale Minecraft Launcher" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       Foreground="Black" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 菜单导航按钮 -->
                        <StackPanel Margin="12,0" Spacing="10">
                            <!-- 1. 主页 -->
                            <Button Command="{Binding NavigateHomeCommand}" Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Margin="15,15,15,10" Height="50" >
                                <Grid>
                                    <Image Source="/Assets/Button2.png" Stretch="Fill"/>
                                    <TextBlock Text="主页" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Black" Foreground="#333"/>
                                </Grid>
                            </Button>

                            <!-- 2. 下载 -->
                            <Button Command="{Binding NavigateDownloadCommand}" Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Margin="15,15,15,10" Height="50">
                                <Grid>
                                    <Image Source="/Assets/Button1.png" Stretch="Fill"/>
                                    <TextBlock Text="下载" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Black" Foreground="#333"/>
                                </Grid>
                            </Button>

                            <!-- 3. 设置 -->
                            <Button Command="{Binding NavigateSettingsCommand}" Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Margin="15,15,15,10" Height="50">
                                <Grid>
                                    <Image Source="/Assets/Button1.png" Stretch="Fill"/>
                                    <TextBlock Text="设置" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Black" Foreground="#333"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 右侧主页内容视图 -->
                <Grid Grid.Column="1" Margin="25" RowDefinitions="Auto, *, Auto">
                    
                    <!-- 顶部区域：左边为当前账户按钮，右边为启动项配置 -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,15">
                        
                        <!-- 左侧当前账户按钮 -->
                        <Button Grid.Column="0"
                                Command="{Binding NavigateAccountCommand}"
                                Background="Transparent" 
                                Padding="0" 
                                BorderThickness="0" 
                                VerticalAlignment="Top"
                                Width="280" 
                                Height="80"
                                Margin="0,15,0,0">
                            <Grid>
                                <Image Source="avares://SMCL/Assets/usr_btn.png" Stretch="Fill"/>
                                <StackPanel Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0">
                                    <!-- 修改这里的 Text 绑定 -->
                                    <TextBlock Text="{Binding CurrentAccountName}" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 右侧启动项配置区域 -->
                        <StackPanel Grid.Column="1" Spacing="12" MaxWidth="320" HorizontalAlignment="Right">
                            <TextBlock Text="启动项配置" FontSize="18" FontWeight="Bold" Foreground="Black"/>
                            
                            <!-- 选择游戏版本 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="选择游戏版本" FontSize="12" Foreground="#676767"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <!-- 下拉框去掉固定宽度，让它自动撑满剩余空间 -->
                                    <ComboBox Grid.Column="0"
                                            HorizontalAlignment="Stretch" 
                                            PlaceholderText="请选择游戏版本" 
                                            ItemsSource="{Binding GameVersions}"
                                            SelectedItem="{Binding SelectedGameVersion}"/>
                                    
                                    <!-- 刷新按钮 -->
                                    <Button Grid.Column="1"
                                            Command="{Binding RefreshGameVersionsCommand}"
                                            Margin="8,0,0,0"
                                            Width="32" Height="32"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="刷新游戏版本列表">
                                        <Grid>
                                            <Image Source="avares://SMCL/Assets/Button1.png" Stretch="Fill"/>
                                            <TextBlock Text="🔄" FontSize="14" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- 选择 Java 版本 + 当前版本高亮提示 -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="选择 Java 版本" FontSize="12" Foreground="Black"/>
                                    <TextBlock Grid.Column="1" 
                                            Text="{Binding SelectedJavaVersion}" 
                                            FontSize="11" 
                                            FontWeight="Bold" 
                                            Foreground="#27AE60"/>
                                </Grid>
                                
                                <ComboBox HorizontalAlignment="Stretch" 
                                        PlaceholderText="手动输入或选择 Java 路径..."
                                        IsEditable="True"
                                        ItemsSource="{Binding JavaPaths}"
                                        Text="{Binding SelectedJavaPath, Mode=TwoWay}"/>
                            </StackPanel>

                            <Button Command="{Binding NavigateGameSettingsCommand}" Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Right" Width="150" Height="40">
                                <Grid>
                                    <Image Source="/Assets/Button1.png" Stretch="Fill"/>
                                    <TextBlock Text="当前游戏设置" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#333"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 中间控制台输出面板 -->
                    <Border Grid.Row="1" 
                            Background="#30000000" 
                            BorderBrush="#44FFFFFF" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10" 
                            Margin="0,0,0,15">
                        <!-- 给 ScrollViewer 加上 x:Name="LogScrollViewer" -->
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DisplayLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LogModel">
                                        <TextBlock Text="{Binding FormattedText}" 
                                                Foreground="{Binding Color}" 
                                                FontFamily="Consolas, Monospace, Courier New" 
                                                FontSize="12" 
                                                LineHeight="18"
                                                TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 底部启动按钮 -->
                    <Button Grid.Row="2" 
                            Command="{Binding LaunchGameCommand}"
                            Background="Transparent" 
                            Padding="0" 
                            BorderThickness="0" 
                            Width="175" 
                            Height="60" 
                            HorizontalAlignment="Right">
                        <Grid>
                            <Image Source="/Assets/Button2.png" Stretch="Fill"/>
                            <TextBlock Text="启 动" FontSize="25" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- 【顶层】：子页面容器 -->
        <TransitioningContentControl Content="{Binding CurrentPage}" 
                                     IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </Grid>
</Window>