<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMCL.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:SMCL.Converters"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
             x:Class="SMCL.Views.DownloadView"
             x:DataType="vm:DownloadViewModel">
             
    <Grid>
        <!-- 【图层 1】：底层背景图片 -->
        <Image Source="avares://SMCL/Assets/background.png" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"/>

        <Grid ColumnDefinitions="250, *">

            <!-- ================= 左侧“资源类型”侧边栏 ================= -->
            <Border Grid.Column="0" Background="#409191D5" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    
                    <!-- 顶部标题栏 -->
                    <StackPanel DockPanel.Dock="Top" Margin="15,20,15,20" Spacing="2">
                        <TextBlock Text="资源类型" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Resource Types" FontSize="11" Foreground="#7F8C8D"/>
                    </StackPanel>

                    <!-- 底部返回按钮 -->
                    <Button Command="{Binding BackCommand}"
                            DockPanel.Dock="Bottom" 
                            Margin="12" 
                            Padding="10" 
                            Background="#EAEAEA" 
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="←" FontSize="14" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                            <TextBlock Text="返回" FontSize="12" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 资源切换菜单列表 -->
                    <StackPanel Margin="12,0" Spacing="10">
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="Minecraft" Margin="15,20,15,10"
                                Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Height="50">
                            <Grid>
                                <Image Source="{Binding MinecraftBtnBg}" Stretch="Fill"/>
                                <TextBlock Text="Minecraft" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#333"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="Java" Margin="15,15,15,10"
                                Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Height="50">
                            <Grid>
                                <Image Source="{Binding JavaBtnBg}" Stretch="Fill"/>
                                <TextBlock Text="Java" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#333"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="Mods" Margin="15,15,15,10"
                                Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Height="50">
                            <Grid>
                                <Image Source="{Binding ModsBtnBg}" Stretch="Fill"/>
                                <TextBlock Text="模组" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#333"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="TexturePacks" Margin="15,15,15,10"
                                Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Height="50">
                            <Grid>
                                <Image Source="{Binding TexturePacksBtnBg}" Stretch="Fill"/>
                                <TextBlock Text="材质包" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#333"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ================= 右侧展示区 ================= -->
            <Border Grid.Column="1" Margin="20" Background="#1A000000" CornerRadius="8" Padding="15">
                <Grid RowDefinitions="*, Auto">
                    
                    <!-- 1. 上部资源面板容器 -->
                    <Grid Grid.Row="0">
                        
                        <!-- ==================== Minecraft 下载面板 (保持你原本的界面) ==================== -->
                        <Grid IsVisible="{Binding IsMinecraftSelected}">
                            <!-- 状态 A：选择版本列表 -->
                            <Grid IsVisible="{Binding !IsConfiguringVersion}" RowDefinitions="Auto, *, Auto" RowSpacing="10">
                                <!-- 顶部栏 -->
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="Minecraft 官方版本列表" FontSize="16" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <!-- 刷新按钮 (Button0.png 灰色) -->
                                    <Button Command="{Binding LoadVersionsCommand}" 
                                            Width="90" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Grid>
                                            <Image Source="avares://SMCL/Assets/Button0.png" Stretch="Fill"/>
                                            <TextBlock Text="刷新列表" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#333" FontSize="12"/>
                                        </Grid>
                                    </Button>
                                </DockPanel>

                                <!-- 列表区 (浅色磨砂卡片) -->
                                <Border Grid.Row="1" Background="#40FFFFFF" CornerRadius="8" Padding="10" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <ListBox ItemsSource="{Binding AvailableVersions}" 
                                            SelectedItem="{Binding SelectedVersion}"
                                            Background="Transparent"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.Styles>
                                            <!-- 让选中项有高亮，悬停有反馈 -->
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="12,8"/>
                                                <Setter Property="Margin" Value="0,2"/>
                                                <Setter Property="CornerRadius" Value="6"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#20FFFFFF"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#804CAF50"/> <!-- 选中变绿 -->
                                            </Style>
                                            <Style Selector="ListBoxItem:selected TextBlock">
                                                <Setter Property="Foreground" Value="White"/> <!-- 选中字变白 -->
                                            </Style>
                                        </ListBox.Styles>
                                        
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                                    <!-- 版本号改深色 -->
                                                    <TextBlock Text="{Binding Id}" FontSize="16" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center"/>
                                                    <!-- 截取发布时间的前10位 (显示为 yyyy-MM-dd) -->
                                                    <TextBlock Grid.Column="1" 
                                                            Text="{Binding ReleaseTime, StringFormat='{}{0:yyyy-MM-dd}'}" 
                                                            FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- 下一步按钮 (Button2.png 金色) -->
                                <Button Grid.Row="2" 
                                        Command="{Binding GoToConfigCommand}" 
                                        HorizontalAlignment="Right" 
                                        Width="200" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Grid>
                                        <Image Source="avares://SMCL/Assets/Button2.png" Stretch="Fill"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="下一步：配置此版本" FontWeight="Bold" Foreground="#333"/>
                                            <TextBlock Text="{Binding SelectedVersion.Id, StringFormat='({0})'}" FontWeight="Bold" Foreground="#333"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 状态 B：版本详细配置面板 -->
                            <ScrollViewer IsVisible="{Binding IsConfiguringVersion}">
                                <StackPanel Spacing="15">
                                    
                                    <!-- 导航返回 header -->
                                    <DockPanel Margin="0,0,0,10">
                                        <Button Command="{Binding BackToVersionListCommand}" 
                                                Content="← 返回版本列表" 
                                                Background="#60FFFFFF" Foreground="#333" 
                                                CornerRadius="6" Padding="10,6" DockPanel.Dock="Left" Cursor="Hand" FontWeight="Bold"/>
                                        <TextBlock Text="版本安装配置" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- 1. 基础版本与名称配置 (浅色磨砂玻璃) -->
                                    <Border Background="#40FFFFFF" CornerRadius="8" Padding="15" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="游戏实例名称（可选）" FontSize="13" FontWeight="Bold" Foreground="#222"/>
                                            <TextBox Text="{Binding CustomInstanceName}" 
                                                    PlaceholderText="例如:1.20.1-fabric"
                                                    Background="#66FFFFFF" 
                                                    Foreground="Black" 
                                                    CaretBrush="Black"
                                                    BorderBrush="#33FFFFFF" 
                                                    CornerRadius="6" 
                                                    Padding="10,8"/>
                                            <TextBlock Text="Fabric/原版支持自定义目录名；Forge 由安装器命名。Fabric 名称不能与基础版本（如 1.20.1）相同。"
                                                       FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding InstanceNameError}"
                                                       IsVisible="{Binding HasInstanceNameError}"
                                                       FontSize="11" Foreground="#D32F2F" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. 模组加载器 (Mod Loader) 选择卡片 -->
                                    <Border Background="#40FFFFFF" CornerRadius="8" Padding="15" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="选择模组加载器 (Mod Loader)" FontSize="14" FontWeight="Bold" Foreground="#222"/>
                                            
                                            <UniformGrid Columns="3" Rows="1">
                                                <!-- Vanilla -->
                                                <Button Command="{Binding SelectLoaderCommand}" CommandParameter="Vanilla" Margin="0,0,10,0" Padding="15,12" CornerRadius="6" Background="#30FFFFFF" Cursor="Hand">
                                                    <Button.Styles>
                                                        <Style Selector="Button">
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <StackPanel Spacing="6">
                                                        <DockPanel>
                                                            <TextBlock Text="原版 (Vanilla)" FontWeight="Bold" FontSize="14" Foreground="#222" DockPanel.Dock="Left"/>
                                                            <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="16" DockPanel.Dock="Right" HorizontalAlignment="Right" IsVisible="{Binding IsVanillaSelected}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="无修改的官方原生客户端" FontSize="11" Foreground="#666"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Fabric -->
                                                <Button Command="{Binding SelectLoaderCommand}" CommandParameter="Fabric" Margin="5,0" Padding="15,12" CornerRadius="6" Background="#30FFFFFF" Cursor="Hand">
                                                    <Button.Styles>
                                                        <Style Selector="Button">
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <StackPanel Spacing="6">
                                                        <DockPanel>
                                                            <TextBlock Text="Fabric" FontWeight="Bold" FontSize="14" Foreground="#222" DockPanel.Dock="Left"/>
                                                            <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="16" DockPanel.Dock="Right" HorizontalAlignment="Right" IsVisible="{Binding IsFabricSelected}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="轻量级、高性能现代化加载器" FontSize="11" Foreground="#666"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Forge -->
                                                <Button Command="{Binding SelectLoaderCommand}" CommandParameter="Forge" Margin="10,0,0,0" Padding="15,12" CornerRadius="6" Background="#30FFFFFF" Cursor="Hand">
                                                    <Button.Styles>
                                                        <Style Selector="Button">
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <StackPanel Spacing="6">
                                                        <DockPanel>
                                                            <TextBlock Text="Forge" FontWeight="Bold" FontSize="14" Foreground="#222" DockPanel.Dock="Left"/>
                                                            <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="16" DockPanel.Dock="Right" HorizontalAlignment="Right" IsVisible="{Binding IsForgeSelected}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="传统大型模组生态加载器" FontSize="11" Foreground="#666"/>
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>

                                            <!-- 动态显示的加载器版本选择器 -->
                                            <StackPanel IsVisible="{Binding !IsVanillaSelected}" Spacing="6" Margin="0,10,0,0">
                                                <TextBlock Text="加载器具体版本" FontSize="13" FontWeight="Bold" Foreground="#222"/>
                                                <ComboBox ItemsSource="{Binding LoaderVersions}" 
                                                        SelectedItem="{Binding SelectedLoaderVersion}" 
                                                        HorizontalAlignment="Stretch" Height="35" 
                                                        Background="#66FFFFFF" Foreground="Black"/>
                                            </StackPanel>

                                            <!-- Fabric API 自动安装选项 -->
                                            <CheckBox Content="自动安装 Fabric API 前置模组（自动匹配 Loader 兼容版本）"
                                                      IsChecked="{Binding AutoInstallFabricApi}"
                                                      IsVisible="{Binding IsFabricSelected}"
                                                      Foreground="#222"
                                                      FontSize="12"
                                                      Margin="0,10,0,0"/>

                                            <TextBlock Text="{Binding SelectedLoader, StringFormat='当前选中: {0}'}" FontSize="13" Foreground="#1565C0" FontWeight="Bold" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- 3. 开始安装下载按钮 (金色材质 Button2.png) -->
                                    <Button Command="{Binding StartDownloadCommand}" 
                                            HorizontalAlignment="Right" 
                                            Width="200" Height="45" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Margin="0,10,0,0">
                                        <Grid>
                                            <Image Source="avares://SMCL/Assets/Button2.png" Stretch="Fill"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="确认并开始安装" FontWeight="Bold" FontSize="15" Foreground="#333"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ==================== Java / 材质包 占位 ==================== -->
                        <StackPanel IsVisible="{Binding IsJavaSelected}" Spacing="10">
                            <TextBlock Text="Java 运行时下载列表" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Java 运行库检索功能待接入..." FontSize="12" Foreground="#AAA"/>
                        </StackPanel>
                        
                        <StackPanel IsVisible="{Binding IsTexturePacksSelected}" Spacing="10">
                            <TextBlock Text="材质包列表" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="材质包检索功能待接入..." FontSize="12" Foreground="#AAA"/>
                        </StackPanel>


                        <!-- ==================== 模组下载面板 (HMCL 风格) ==================== -->
                        <Grid IsVisible="{Binding IsModsSelected}" RowDefinitions="Auto, *">
                            
                            <!-- 状态 A：搜索与列表 -->
                            <Grid Grid.RowSpan="2" IsVisible="{Binding !IsModDetailVisible}" RowDefinitions="Auto, Auto, *">
                                
                                <!-- 1. 顶部：游戏实例选择 + 搜索框 -->
                                <Grid Grid.Row="0" ColumnDefinitions="200, *, 100" Margin="0,0,0,10">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                        <TextBlock Text="游戏实例" FontSize="12" Foreground="White"/>
                                        <ComboBox ItemsSource="{Binding AvailableInstances}" 
                                                  SelectedItem="{Binding SelectedDownloadInstance, Mode=TwoWay}" 
                                                  Height="35" HorizontalAlignment="Stretch" 
                                                  Background="#33FFFFFF" Foreground="Black"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="5,0">
                                        <TextBlock Text="搜索名称" FontSize="12" Foreground="White"/>
                                        <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" 
                                                 PlaceholderText="支持中英文搜索..." 
                                                 Height="35" VerticalContentAlignment="Center" 
                                                 CornerRadius="6" Background="#33FFFFFF" Foreground="Black" 
                                                 BorderBrush="#55FFFFFF"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Bottom">
                                        <Button Command="{Binding SearchModsCommand}" 
                                                Height="35" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Grid>
                                                <Image Source="avares://SMCL/Assets/Button1.png" Stretch="Fill"/>
                                                <TextBlock Text="搜索" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 2. 第二行：分页栏 -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,10">
                                    <Button Grid.Column="0" Command="{Binding PrevPageCommand}" 
                                            Width="80" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Grid>
                                            <Image Source="avares://SMCL/Assets/Button1.png" Stretch="Fill"/>
                                            <TextBlock Text="上一页" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                        </Grid>
                                    </Button>
                                    
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CurrentPage, StringFormat='第 {0} 页'}" 
                                               Foreground="White" FontWeight="Bold" FontSize="14" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                               
                                    <Button Grid.Column="2" Command="{Binding NextPageCommand}"
                                            Width="80" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Grid>
                                            <Image Source="avares://SMCL/Assets/Button1.png" Stretch="Fill"/>
                                            <TextBlock Text="下一页" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <!-- 3. 第三行：结果列表 (优化视觉层次) -->
                                <Border Grid.Row="2" Background="#40FFFFFF" CornerRadius="8" Padding="10" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="CornerRadius" Value="6"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding $parent[ItemsControl].((vm:DownloadViewModel)DataContext).ViewModDetailCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="10"
                                                        Cursor="Hand"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5">
                                                        <!-- 缩略图占位，美观圆角 -->
                                                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="8" ClipToBounds="True" Background="#20000000">
                                                            <Grid>
                                                                <TextBlock Text="?" FontSize="24" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                        IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 文字信息 -->
                                                        <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center" Spacing="3">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#222" FontSize="15"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="#555" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                            <TextBlock Text="{Binding Author, StringFormat='作者: {0}'}" Foreground="#888" FontSize="11"/>
                                                        </StackPanel>
                                                        
                                                        <!-- 悬浮高亮的动作指示 -->
                                                        <Border Grid.Column="2" Background="#102196F3" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                                                            <TextBlock Text="查看 →" Foreground="#1565C0" FontWeight="Bold" FontSize="13"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <!-- 状态 B：模组详情页 -->
                            <Grid Grid.RowSpan="2" IsVisible="{Binding IsModDetailVisible}" RowDefinitions="Auto, *, Auto" Background="#1A000000">
                                <!-- 顶部信息栏 -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,15">
                                    <Button Grid.Column="0" Command="{Binding CloseModDetailCommand}" 
                                            Content="← 返回列表" Background="#33FFFFFF" Foreground="#333" 
                                            CornerRadius="4" Padding="10,5" Margin="0,0,15,0" VerticalAlignment="Center" Cursor="Hand" FontWeight="Bold"/>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="6" ClipToBounds="True" Background="#33FFFFFF">
                                            <Image Source="{Binding CurrentModDetail.CoverImage}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentModDetail.Title}" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                                            <TextBlock Text="{Binding CurrentModDetail.Description}" FontSize="12" Foreground="#555" TextTrimming="CharacterEllipsis" MaxWidth="500" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 版本列表区域 -->
                                <Border Grid.Row="1" Background="#40FFFFFF" CornerRadius="6" Padding="15" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding ModVersionGroups}" HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" 
                                                              HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch"
                                                              Background="#30FFFFFF" CornerRadius="6" Margin="0,0,0,10" Padding="5"
                                                              Foreground="#333">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding GameVersion, StringFormat='Minecraft {0}'}" FontWeight="Bold" FontSize="15" Foreground="#111"/>
                                                        </Expander.Header>
                                                        
                                                        <ListBox ItemsSource="{Binding Versions}" 
                                                                 SelectedItem="{Binding $parent[ItemsControl].((vm:DownloadViewModel)DataContext).SelectedModVersion, Mode=TwoWay}"
                                                                 Background="Transparent" Margin="0,10,0,0"
                                                                 BorderThickness="0">
                                                            <ListBox.Styles>
                                                                <Style Selector="ListBoxItem">
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                    <Setter Property="Padding" Value="12,10"/>
                                                                    <Setter Property="Margin" Value="0,2"/>
                                                                    <Setter Property="Background" Value="#30FFFFFF"/>
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                </Style>
                                                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#50FFFFFF"/>
                                                                </Style>
                                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#604CAF50"/>
                                                                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </Style>
                                                            </ListBox.Styles>

                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#222"/>
                                                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,5,0,0">
                                                                                <Border Background="#202196F3" CornerRadius="3" Padding="4,1">
                                                                                    <TextBlock Text="{Binding VersionType}" Foreground="#1565C0" FontSize="11" FontWeight="Bold"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding DatePublished, StringFormat='发布于 {}{0:yyyy-MM-dd}'}" Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                        
                                                                        <Border Grid.Column="1" Background="#30000000" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Loaders[0]}" Foreground="#555" FontSize="12" FontWeight="Bold"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- 底部操作栏 -->
                                <Grid Grid.Row="2" Margin="0,15,0,0" ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{Binding SelectedModVersion.Name, StringFormat='已选中: {0}'}" Foreground="#333" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                                        <Button Content="取消" Command="{Binding CloseModDetailCommand}" 
                                                Background="#33FFFFFF" Foreground="#333" Padding="15,8" CornerRadius="6" Cursor="Hand" FontWeight="Bold"/>
                                        
                                        <Button Command="{Binding InstallSelectedModCommand}" 
                                                IsEnabled="{Binding SelectedModVersion, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Width="160" Height="45" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Grid>
                                                <Image Source="avares://SMCL/Assets/Button2.png" Stretch="Fill"/>
                                                <TextBlock Text="安装到实例" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="#333"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                        </Grid>
                    </Grid>

                    <!-- 2. 右侧底部：下载进度条面板 -->
                    <Border Grid.Row="1" 
                            Margin="0,12,0,0" 
                            Padding="12,10" 
                            Background="#60000000" 
                            CornerRadius="6" 
                            IsVisible="{Binding IsDownloading}">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="White" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DownloadProgress, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="#4CAF50" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" CornerRadius="3" Foreground="#4CAF50" Background="#33FFFFFF"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>