<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMCL.ViewModels"
             xmlns:models="using:SMCL.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
             x:Class="SMCL.Views.GameSettingsView"
             x:DataType="vm:GameSettingsViewModel">
    <Grid>
        <!-- 【图层 1】：底层背景图片 -->
        <Image Source="avares://SMCL/Assets/background.png" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"/>

        <Grid ColumnDefinitions="250, *">

            <!-- ================= 左侧设置侧边栏 ================= -->
            <Border Grid.Column="0" Background="#409191D5" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    
                    <!-- 顶部标题栏 -->
                    <StackPanel DockPanel.Dock="Top" Margin="15,20,15,20" Spacing="2">
                        <TextBlock Text="当前游戏设置" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="{Binding InstanceName}" FontSize="11" Foreground="#7F8C8D" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 底部返回按钮 -->
                    <Button Command="{Binding BackCommand}"
                            DockPanel.Dock="Bottom" 
                            Margin="12" 
                            Padding="10" 
                            Background="#EAEAEA" 
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="←" FontSize="14" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                            <TextBlock Text="返回" FontSize="12" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 侧边栏菜单按钮列表 -->
                    <StackPanel Margin="12,0" Spacing="10">
                        <!-- 1. 游戏配置 -->
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="GameConfig" Margin="15,20,15,10"
                                Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Height="50">
                            <Grid>
                                <Image Source="{Binding GameConfigBtnBg}" Stretch="Fill"/>
                                <TextBlock Text="游戏配置" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#333"/>
                            </Grid>
                        </Button>

                        <!-- 2. 模组管理 -->
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="ModManager" Margin="15,15,15,10"
                                Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Height="50">
                            <Grid>
                                <Image Source="{Binding ModManagerBtnBg}" Stretch="Fill"/>
                                <TextBlock Text="模组管理" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#333"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ================= 右侧设置内容展示区 ================= -->
            <Border Grid.Column="1" Margin="25" Background="#10000000" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- 1. 游戏配置面板 -->
                        <StackPanel IsVisible="{Binding IsGameConfigSelected}" Spacing="18">
                            <TextBlock Text="游戏配置" FontSize="18" FontWeight="Black" Foreground="Black"/>

                            <!-- 全局继承开关 -->
                            <Border Background="#20FFFFFF" CornerRadius="6" Padding="12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                                        <TextBlock Text="启用独立游戏配置" FontSize="14" FontWeight="Bold" Foreground="Black"/>
                                        <TextBlock Text="开启后将覆盖全局设置中的内存分配与 JVM 参数" FontSize="11" Foreground="#555"/>
                                    </StackPanel>
                                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding UseCustomSettings}" OnContent="开启" OffContent="继承全局"/>
                                </DockPanel>
                            </Border>

                            <!-- 版本快捷目录管理 (按钮使用 Button1.png 材质) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="版本快捷目录管理" FontSize="13" Foreground="Black"/>
                                <Grid ColumnDefinitions="*, *, *">
                                    <Button Grid.Column="0" Command="{Binding OpenFolderCommand}" CommandParameter="Root" Margin="0,0,4,0" Height="40" Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Image Source="avares://SMCL/Assets/Button1.png" Stretch="Fill"/>
                                            <TextBlock Text="📁 打开版本目录" FontSize="12" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding OpenFolderCommand}" CommandParameter="Mods" Margin="2,0,2,0" Height="40" Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Image Source="avares://SMCL/Assets/Button1.png" Stretch="Fill"/>
                                            <TextBlock Text="🧩 打开 Mods 目录" FontSize="12" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding OpenFolderCommand}" CommandParameter="Saves" Margin="4,0,0,0" Height="40" Background="Transparent" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Image Source="avares://SMCL/Assets/Button1.png" Stretch="Fill"/>
                                            <TextBlock Text="🗺️ 打开存档目录" FontSize="12" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- 独立分配内存（改为输入框） -->
                            <StackPanel Spacing="6" IsEnabled="{Binding UseCustomSettings}">
                                <TextBlock Text="最大分配内存 (MB)" FontSize="13" Foreground="Black"/>
                                <TextBox Text="{Binding CustomMemory}" Watermark="请输入内存大小 (例如 4096)..." Height="35" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- 独立 JVM 参数 -->
                            <StackPanel Spacing="6" IsEnabled="{Binding UseCustomSettings}">
                                <TextBlock Text="特定 JVM 启动参数" FontSize="13" Foreground="Black"/>
                                <TextBox Text="{Binding CustomJvmArgs, Mode=TwoWay}" 
                                        Watermark="-XX:+UseG1GC -XX:HeapDumpPath=..." 
                                        Height="35" 
                                        VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- 自定义 Minecraft 启动参数 -->
                            <StackPanel Spacing="6" IsEnabled="{Binding UseCustomSettings}">
                                <TextBlock Text="自定义 Minecraft 启动参数 (Game Arguments)" FontSize="13" Foreground="Black"/>
                                <TextBox Text="{Binding CustomMcArgs, Mode=TwoWay}" 
                                        Watermark="--demo --fullscreen..." 
                                        Height="35" 
                                        VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <!-- 修改版本显示名称 -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="修改版本显示名称" FontSize="13" Foreground="Black"/>
                                <TextBox Text="{Binding InstanceName}" Height="35" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. 模组管理面板 -->
                        <StackPanel IsVisible="{Binding IsModManagerSelected}" Spacing="15">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <TextBlock Grid.Column="0" Text="模组管理" FontSize="18" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                
                                <!-- 工具栏按钮 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Click="OnAddModClick" Height="32" Padding="10,0" CornerRadius="4" Background="#EAEAEA">
                                        <TextBlock Text="+ 添加 Mod" FontSize="12" Foreground="#333" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Command="{Binding RefreshModsCommand}" Height="32" Padding="10,0" CornerRadius="4" Background="#EAEAEA">
                                        <TextBlock Text="🔄 刷新" FontSize="12" Foreground="#333" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Command="{Binding OpenFolderCommand}" CommandParameter="Mods" Height="32" Padding="10,0" CornerRadius="4" Background="#EAEAEA">
                                        <TextBlock Text="📁 打开文件夹" FontSize="12" Foreground="#333" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Mod 列表视图 -->
                            <Border Background="#20FFFFFF" CornerRadius="6" Padding="8" MinHeight="300">
                                <Grid>
                                    <!-- 无 Mod 时的提示 -->
                                    <TextBlock Text="当前文件夹下无 Mod 文件，点击上方“添加 Mod”或放入 Jar 文件" 
                                            IsVisible="{Binding !Mods.Count}"
                                            FontSize="13" Foreground="#666" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Mod 列表 -->
                                    <ListBox ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ModModel">
                                                <Border Background="#10000000" CornerRadius="4" Padding="8,4" Margin="0,2">
                                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                        <TextBlock Grid.Column="0" Text="🧩" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        
                                                        <TextBlock Grid.Column="1" 
                                                                Text="{Binding FileName}" 
                                                                FontSize="13" 
                                                                Foreground="Black" 
                                                                VerticalAlignment="Center" 
                                                                TextTrimming="CharacterEllipsis"/>

                                                        <ToggleSwitch Grid.Column="2" 
                                                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                                    OnContent="已启用" 
                                                                    OffContent="已禁用" 
                                                                    Margin="10,0"/>

                                                        <Button Grid.Column="3" 
                                                                Command="{Binding $parent[UserControl].((vm:GameSettingsViewModel)DataContext).DeleteModCommand}" 
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" 
                                                                Padding="5"
                                                                ToolTip.Tip="删除 Mod">
                                                            <TextBlock Text="🗑️" FontSize="14"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</UserControl>